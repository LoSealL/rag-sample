# Local LLM service (chat completions)
LOCAL_LLM_BASE_URL=http://localhost:8000
# Embedding service (if different from LLM, otherwise same as above)
EMBEDDING_BASE_URL=http://localhost:8000
# Optional auth key for local gateway
LOCAL_API_KEY=
# API style: auto | openai | anthropic
LLM_PROVIDER=auto
# Local model names
LLM_MODEL=Qwen3.5-8B
# Optional: max generation tokens (leave commented for server default)
# LOCAL_LLM_MAX_TOKENS=8192
# Optional: request timeout in seconds
# LOCAL_LLM_TIMEOUT_SECONDS=300

# Rerank options
# Enable SentenceTransformer reranking: true | false
SEC_RAG_ENABLE_RERANK=true
# Reranker model name
SEC_RAG_RERANK_MODEL=BAAI/bge-reranker-base
# Candidate multiplier before rerank (effective candidates = top_k * N)
SEC_RAG_RERANK_CANDIDATE_MULTIPLIER=4

# Embedding model name
EMBEDDING_MODEL=Qwen3-VL-Embedding-8B
# Directory to persist ChromaDB index
RAG_INDEX_DIR=.rag_index
